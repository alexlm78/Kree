# .editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 3
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{properties,yaml,yml,toml,json,ipynb}]
indent_size = 2
indent_style = space
ruler = 96
max_line_length = 96

[*.{html,htm,xml,xsd,xsl,wsdl,css,scss,less,vue,xaml,resx,props,targets,config,pcfproj}]
indent_size = 2
ruler = 512
max_line_length = 512

[*.{adoc,md}]
ruler = 1000
max_line_length = 1000
indent_size = 2
trim_trailing_whitespace = false

[*.{js,ts,tsx,jsx,jsm,mjs}]
indent_size = 3

[*.rs]
indent_size = 4
indent_style = space
max_line_length = 100

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4
indent_style = space

[COMMIT_EDITMSG]
max_line_length = 120

